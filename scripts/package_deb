#!/bin/bash

set -e

PACKAGE_DIR=$(realpath "${PACKAGE_DIR:-$(pwd)/package}")
TEMP=$(mktemp -d)
DIRNAME=$(basename "$(pwd)")
USER=$(id -u -n)

WORKDIR=$TEMP/$DIRNAME

mkdir "$WORKDIR"
cp -r ./* "$WORKDIR"

(
	cd "$WORKDIR"

	VERSION=$(dpkg-parsechangelog --show-field Version | cut -d '-' -f 1)
	PACKAGE=$(dpkg-parsechangelog --show-field Source)

	debmake -yt
	cd "../$PACKAGE-$VERSION"

	sudo pbuilder update
	sudo pdebuild --buildresult "$PACKAGE_DIR" -- --use-network yes
	sudo chown -R "$USER:$USER" "$PACKAGE_DIR"
)

rm -rf "$TEMP"
debsign --no-re-sign "$PACKAGE_DIR"/*.changes
lintian -i -I --show-overrides "$PACKAGE_DIR"/*.changes
